{
  "name": "pixtuoid-site",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.0.0 <13"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test:unit": "node --test \"config/**/*.test.mjs\"",
    "test:demos": "node --test \"config/**/*.demos.mjs\"",
    "check:docs": "node config/assert-docs-rendered.mjs dist",
    "audit": "npm audit --audit-level=low",
    "verify": "npm run format:check && npm run lint && npm run check && npm run knip && npm run test:unit && npm run test:demos && npm run build && npm run check:docs && npm run audit",
    "lighthouse": "node config/lighthouse-runner.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "astro": "^7.3.7",
    "beautiful-mermaid": "^1.1.3",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-text": "^4.0.2",
    "knip": "^6.40.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prismjs": "1.30.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "unist-util-visit": "^5.1.0",
    "web-vitals": "6.2.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  }
}
