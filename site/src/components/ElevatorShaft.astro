---
import { FLOORS, FLOOR_SPY_ROOT_MARGIN, BOTTOM_CLAMP_EPSILON_PX } from '../consts';

// A slim pixel shaft fixed at the right edge; a pixel car rides 6F→1F with
// scroll. index-only chrome — the docs pages get the elevator-PANEL sidebar.
---

<aside class="shaft" data-shaft>
  <nav class="shaft__rail hw-panel" aria-label="Elevator — ride to a floor">
    {FLOORS.map((f) => <button
      class="shaft__stop"
      data-shaft-stop={f.fl}
      aria-label={`${f.fl} ${f.label}`}
      aria-current={f.fl === '6F' ? 'true' : undefined}
    >
      <span class="led-dot" aria-hidden="true" />
      <span class="shaft__plate hw-panel" aria-hidden="true"> <b>{f.fl}</b> {f.label} </span>
    </button>)}
    <span class="shaft__car" data-shaft-car aria-hidden="true"></span>
  </nav>
  {/* no keys hint here — the statusline owns the ONE "keys 1–6" affordance */}
</aside>

<script
  is:inline
  define:vars={{
    floorSpyRootMargin: FLOOR_SPY_ROOT_MARGIN,
    bottomClampEpsilonPx: BOTTOM_CLAMP_EPSILON_PX,
  }}
>
  (function () {
    const shaft = document.querySelector('[data-shaft]');
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const car = shaft.querySelector('[data-shaft-car]');
    const stops = Array.prototype.slice.call(shaft.querySelectorAll('[data-shaft-stop]'));
    let userPaused = false;
    let sections = [];

    function resolveSections() {
      sections = stops
        .map(function (s) {
          return document.querySelector('[data-floor="' + s.dataset.shaftStop + '"]');
        })
        .filter(Boolean);
    }

    stops.forEach(function (s) {
      s.addEventListener('click', function () {
        const sec = document.querySelector('[data-floor="' + s.dataset.shaftStop + '"]');
        if (!sec) return;
        sec.scrollIntoView({ behavior: mq.matches ? 'auto' : 'smooth', block: 'start' });
        sec.setAttribute('tabindex', '-1');
        sec.focus({ preventScroll: true });
      });
    });

    let currentFl = null;
    function arrive(fl) {
      if (fl === currentFl) return;
      const first = currentFl === null; // no ding on initial load
      currentFl = fl;
      stops.forEach(function (s) {
        const on = s.dataset.shaftStop === fl;
        if (on) s.setAttribute('aria-current', 'true');
        else s.removeAttribute('aria-current');
        s.classList.toggle('led-selected', on);
        if (on && !first && !mq.matches && !userPaused) {
          s.classList.remove('is-ding');
          void s.offsetWidth;
          s.classList.add('is-ding');
        }
      });
    }

    let raf = 0;
    function ride() {
      raf = 0;
      if (!sections.length) return;
      const mid = window.scrollY + window.innerHeight / 2;
      let i = 0;
      while (i < sections.length - 1 && mid >= sections[i + 1].offsetTop) i++;
      const top = sections[i].offsetTop;
      const next =
        i < sections.length - 1 ? sections[i + 1].offsetTop : document.documentElement.scrollHeight;
      const within = Math.min(1, Math.max(0, (mid - top) / Math.max(1, next - top)));
      const a = stops[i].offsetTop;
      const b = stops[Math.min(i + 1, stops.length - 1)].offsetTop;
      car.style.transform = 'translateY(' + Math.round(a + (b - a) * within) + 'px)';
    }
    function queueRide() {
      if (!raf) raf = requestAnimationFrame(ride);
    }
    window.addEventListener('scroll', queueRide, { passive: true });
    window.addEventListener('resize', queueRide);

    function observe() {
      resolveSections();
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) arrive(e.target.dataset.floor);
            });
          },
          { rootMargin: floorSpyRootMargin, threshold: 0 }
        );
        sections.forEach(function (s) {
          io.observe(s);
        });
      }
      queueRide();
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', observe, { once: true });
    } else {
      observe();
    }

    // 1F + the footer rarely fill the FLOOR_SPY_ROOT_MARGIN center band the
    // observer keys off, so at the true scroll max the last floor's LED wins
    // unconditionally, overriding whatever the observer last reported.
    function clampToLastFloorAtBottom() {
      const atBottom =
        window.scrollY + window.innerHeight >=
        document.documentElement.scrollHeight - bottomClampEpsilonPx;
      if (atBottom) arrive(stops[stops.length - 1].dataset.shaftStop);
    }
    // straight from the scroll event: it already fires at the frame rate (MDN scroll_event)
    window.addEventListener('scroll', clampToLastFloorAtBottom, { passive: true });
    clampToLastFloorAtBottom(); // a hash-anchored load can already start at the bottom

    // The pause switch stills the ding pulse ONLY. The car keeps riding while
    // paused: it moves solely WITH user scroll, like a scrollbar thumb, so it
    // sits outside WCAG 2.2.2's auto-motion scope.
    document.addEventListener('pix:paused', function (e) {
      userPaused = !!(e.detail && e.detail.paused);
    });
  })();
</script>

<style is:global>
  :root {
    --shaft-edge: clamp(4px, 0.6vw, 10px);
    --shaft-w: 24px;
  }
  @media (max-width: 760px) {
    :root {
      --shaft-w: 14px;
    }
  }
  /* 960px, not the 760px dot-rail cutover: the shaft is position:fixed at every
     width and .container's own padding leaves no room to clear it once the
     viewport narrows (measured: body text runs under the rail at 768px too). */
  @media (max-width: 960px) {
    body {
      padding-right: calc(var(--shaft-edge) + var(--shaft-w) + 8px);
    }
  }
</style>

<style>
  .shaft {
    position: fixed;
    right: var(--shaft-edge);
    top: 50%;
    transform: translateY(-50%);
    /* under the statusline (50) and its floor popover, over the office */
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
  }
  .shaft__rail {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: var(--shaft-w);
    height: min(52vh, 420px);
    padding: 8px 0;
  }
  .shaft__stop {
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
    background: none;
    border: 0;
    padding: 6px 0;
    cursor: pointer;
  }
  .shaft__plate {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.28rem 0.55rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .shaft__plate b {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.05em;
  }
  .shaft__stop:hover .shaft__plate,
  .shaft__stop:focus-visible .shaft__plate {
    opacity: 1;
  }
  /* .led-selected (global) recolors TEXT only — without this the current
     floor's dot would stay perpetually "off". */
  .shaft__stop.led-selected :global(.led-dot) {
    background: var(--led);
    box-shadow: 0 0 6px var(--led-glow);
  }
  .shaft__car {
    position: absolute;
    top: 0;
    left: 50%;
    margin-left: -4px;
    width: 8px;
    height: 16px;
    background: var(--coral);
    image-rendering: pixelated;
    transition: transform 0.25s ease;
    will-change: transform;
    pointer-events: none;
  }
  @keyframes shaft-ding {
    0% {
      box-shadow: 0 0 0 0 var(--led-glow);
    }
    100% {
      box-shadow: 0 0 12px 5px transparent;
    }
  }
  .shaft__stop.is-ding :global(.led-dot) {
    animation: shaft-ding 0.6s ease-out 1;
  }
  @media (prefers-reduced-motion: reduce) {
    /* Not redundant with global.css's sitewide reset: that forces
       transition-duration near-zero, this zeroes transition-PROPERTY, the one
       longhand the reset doesn't touch. */
    .shaft__car {
      transition: none;
    }
    .shaft__stop.is-ding :global(.led-dot) {
      animation: none;
    }
  }
  @media (max-width: 760px) {
    .shaft__rail {
      height: 38vh;
      padding: 6px 0;
    }
    .shaft__plate,
    .shaft__car {
      display: none;
    }
  }
  @media (pointer: coarse) {
    /* Deliberately no touch-target bump: the shaft stays slim (it reads as
       hardware, not a button bar). The applicable SC is 2.5.8 (AA, 24×24), not
       2.5.5 (AAA), and its "equivalent control" exception is met by the
       statusline's own floor list (sl__floorbtn) at ~40.9px. */
  }
</style>
