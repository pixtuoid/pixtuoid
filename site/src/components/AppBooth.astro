---
import { Image } from 'astro:assets';
import ipadOffice from '../assets/app/ipad-office.png';
import iphoneOffice from '../assets/app/iphone-office.png';
import { floorById, floorName } from '../../config/floors.mjs';

const floor = floorById('app');
---

<section id={floor.id} class="app" data-lit data-floor={floor.fl} data-floor-label={floor.label}>
  <div class="container app__grid">
    <div class="app__copy text-scrim reveal">
      <p class="eyebrow">{floor.fl} · {floorName(floor)} — coming soon · iPhone and iPad</p>
      <h2 class="statement statement--md">The office,<br />as an App.</h2>
      <p class="app__lead">
        No agents? The demo office, a cat or dog and lofi still keep you company.
      </p>
      {/* The App is unreleased, so no line names a price, a date or another platform. */}
      <ul class="app__features">
        <li>
          A demo office, a companion cat or dog, and lofi that follows the office: no computer
          needed.
        </li>
        <li>A widget for the Home Screen, StandBy and the Lock Screen.</li>
        <li>
          Tap anyone to see what they’re working on, and open the list to see who’s waiting for you.
        </li>
        <li>
          Pair once: scan or paste the link <code>pixtuoid pair</code> prints, and your agents move
          in live from <code>pixtuoid serve</code>, straight from your computer over your own
          network, with no server in between.
        </li>
        <li>Connecting a computer is paid; the demo office, lofi and your companion stay free.</li>
      </ul>
    </div>
    <div class="app__devices reveal">
      <div class="app__stack">
        {/* `densities`, not `sizes`: a `sizes` list would copy this layout's widths. */}
        <Image
          class="app__ipad"
          src={ipadOffice}
          alt="The pixtuoid App on an iPad and an iPhone, each showing the pixel office with agents at their desks."
          width={700}
          densities={[1, 2]}
        />
        <Image class="app__iphone" src={iphoneOffice} alt="" width={300} densities={[1, 2]} />
      </div>
      <p class="app__note text-scrim">
        The App is still in development. Features and screenshots may change before release.
      </p>
    </div>
  </div>
</section>

<style>
  .app__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .app__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  /* The whole column is one plate, so its edge is the column's: no text-scrim
     margin pulling it past the grid track. */
  .app__copy {
    --scrim-pad-x: clamp(1.1rem, 2.5vw, 1.8rem);
    margin-inline: 0;
    padding-block: clamp(1.2rem, 2.5vw, 1.8rem);
  }
  .app__lead {
    margin: 1.1rem 0 0;
    font-size: 1.15rem;
    line-height: 1.5;
  }
  .app__features {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }
  .app__features li {
    position: relative;
    padding-left: 1.4rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .app__features li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--coral-deep);
  }
  .app__features code {
    font-size: 0.85em;
    color: var(--fg);
  }
  /* The iPad sits back; the iPhone steps in front of its lower left. */
  .app__stack {
    position: relative;
    padding: 0 0 12% 14%;
  }
  .app__ipad,
  .app__iphone {
    display: block;
    height: auto;
    background: var(--screen);
    border: 6px solid var(--screen);
    box-shadow: var(--shadow-lg);
  }
  .app__ipad {
    width: 100%;
    border-radius: 22px;
  }
  .app__iphone {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 27%;
    border-width: 5px;
    border-radius: 26px;
  }
  .app__note {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
</style>
