---
// The styles of the figures config/rehype-figures.mjs draws in rendered markdown.
---

<style is:global>
  /* ── flow: the Mermaid render in the terminal chrome Docs.astro gives a callout */
  /* The padding is the body's, so the svg's min-width bounds exactly what Mermaid drew. */
  .fig__body {
    overflow-x: auto;
    padding: 1.1rem;
  }
  /* global.css's `.prose svg` pairs the library's --surface/--muted/--border
     hooks with the page and frames the diagram as a card; inside the terminal
     they pair with the screen, and the figure is the frame. */
  .prose .fig--flow svg {
    --bg: var(--screen);
    --fg: var(--chip-bright);
    --surface: var(--hw-hover);
    --muted: var(--chip-ink);
    --border: var(--chip-dim);
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .fig--flow svg .fig-flow__end > :is(rect, polygon, path, circle, ellipse) {
    stroke: var(--amber);
    stroke-width: 1.5;
  }

  /* ── cards: one per role */
  .prose .fig-cards {
    display: grid;
    margin: 1.8rem 0;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 0.9rem;
    padding: 0;
    list-style: none;
  }
  .prose .fig-card {
    margin: 0;
    padding: 1rem 1.1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
  }
  .prose .fig-card__role {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.1;
    color: var(--fg);
  }
  /* Past global.css's theme-prefixed `.prose a` (0,3,1), which tints night's and
     dracula's links: a role's name reads as the card's title in every theme. */
  .prose .fig-cards .fig-card .fig-card__role a {
    color: inherit;
    font-weight: inherit;
  }
  .prose .fig-card__acts {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
  }
</style>
