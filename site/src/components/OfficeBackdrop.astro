---
import { asset, DIM_RESTING } from '../consts';

const wasmJsUrl = asset('wasm/pixtuoid_web.js');
const audioWorkerUrl = asset('audio-worker.js');
const musicWorkerUrl = asset('music-worker.js');
const musicWorkletUrl = asset('music-worklet.js');
const officeDriverUrl = asset('office-driver.js');
---

{/* The wasm office renders into #office-live; the poster is the instant
     FALLBACK layer — reduced-motion / no-JS / no-wasm / fetch-failure all
     simply stay on it. */}
<div class="backdrop" aria-hidden="true">
  <img
    class="backdrop__poster px"
    src={asset('demos/hero-wide.png')}
    alt=""
    width="231"
    height="130"
    decoding="async"
    fetchpriority="high"
  />
  <canvas id="office-live" class="backdrop__live px"></canvas>
  {/* Crisp DOM text laid OVER the pixel office: the canvas buffer is upscaled
       with image-rendering:pixelated, so baked AA text would nearest-neighbor
       blow up blocky. The engine exports the labels + wall-board as a model
       (Office.overlay_json) and these spans are positioned at DISPLAY
       resolution via the object-fit:cover mapping. */}
  <div id="office-overlay" class="backdrop__overlay" aria-hidden="true"></div>
</div>
{/* --dim-rest single-sources the resting opacity with consts DIM_RESTING — a
     JS↔CSS value that can't share a literal, so it rides an inline custom
     property both #dimmer rules read. */}
<div id="dimmer" aria-hidden="true" style={`--dim-rest:${DIM_RESTING}`}></div>
<button
  id="office-pause"
  class="office-ctl"
  hidden
  aria-pressed="false"
  aria-label="Pause the office animation"
>
  <svg class="office-ctl__pause" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
    <rect x="1" y="1" width="2" height="6"></rect>
    <rect x="5" y="1" width="2" height="6"></rect>
  </svg>
  <svg class="office-ctl__play" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
    <rect x="2" y="1" width="1" height="7"></rect>
    <rect x="3" y="2" width="1" height="5"></rect>
    <rect x="4" y="3" width="1" height="3"></rect>
    <rect x="5" y="4" width="1" height="1"></rect>
  </svg>
</button>
{/* The ♩ office-sound toggle starts OFF: muted-by-default + browser autoplay
     policy (no sound without a gesture). JS un-hides it once the engine is
     live — no engine, no sound to offer. */}
<button
  id="office-audio"
  class="office-ctl"
  hidden
  aria-pressed="false"
  aria-label="Play the office ambient sound"
>
  <svg
    class="office-ctl__soundon"
    viewBox="0 0 8 8"
    shape-rendering="crispEdges"
    aria-hidden="true"
  >
    <rect x="1" y="3" width="1" height="2"></rect>
    <rect x="2" y="2" width="1" height="4"></rect>
    <rect x="3" y="1" width="1" height="6"></rect>
    <rect x="5" y="2" width="1" height="1"></rect>
    <rect x="6" y="3" width="1" height="2"></rect>
    <rect x="5" y="5" width="1" height="1"></rect>
  </svg>
  <svg
    class="office-ctl__soundoff"
    viewBox="0 0 8 8"
    shape-rendering="crispEdges"
    aria-hidden="true"
  >
    <rect x="1" y="3" width="1" height="2"></rect>
    <rect x="2" y="2" width="1" height="4"></rect>
    <rect x="3" y="1" width="1" height="6"></rect>
    <rect x="5" y="2" width="1" height="1"></rect>
    <rect x="6" y="3" width="1" height="1"></rect>
    <rect x="5" y="5" width="1" height="1"></rect>
    <rect x="6" y="4" width="1" height="1"></rect>
  </svg>
</button>

<style is:global>
  body {
    background: transparent;
  }
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--bg);
    pointer-events: none;
  }
  .backdrop__poster,
  .backdrop__live {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Default 0: every NON-boot path shows the poster, and boot's own bg-tone cover never cross-dissolves a wrong-time still. */
  .backdrop__live {
    opacity: 0;
    background: var(--bg);
  }
  /* reduced motion IS the still-poster design — never cover it, and win before the script even runs */
  @media (prefers-reduced-motion: reduce) {
    .backdrop__live {
      opacity: 0 !important;
    }
  }
  .backdrop__overlay {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    font-family: var(--font-mono);
    --ov-label-px: 12px;
  }
  .backdrop__overlay.is-on {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .backdrop__overlay {
      display: none !important;
    }
  }
  .ov-label {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    font-size: var(--ov-label-px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.01em;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.9),
      0 0 3px rgba(0, 0, 0, 0.75);
    will-change: transform;
  }
  /* The office marks a badge with a bar in its source's hue, not a dot. */
  .ov-strip {
    display: inline-block;
    width: 0.22em;
    height: 1.05em;
    margin-right: 0.25em;
    vertical-align: -0.12em;
    overflow: hidden;
    color: transparent;
    text-shadow: none;
  }
  /* A status lamp with a glint, glowing in its tone, where the glyph was. */
  .ov-lamp {
    color: transparent;
    text-shadow: none;
    background: radial-gradient(
      circle at 38% 38%,
      #fff 0 10%,
      var(--lamp) 14% 36%,
      transparent 40%
    );
    filter: drop-shadow(0 0 0.12em var(--lamp));
  }
  .ov-board {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.85);
    will-change: transform;
  }
  /* The engine BAKES the mood/context separators as spaces and re-cuts the
     segments every tick of a flap roll: `pre` + no gap keeps each char on its own
     monospace column, where `nowrap` + a gap collapsed the spaces and let the
     row jump as the segment count changed. */
  .ov-brow {
    display: flex;
    white-space: pre;
  }
  .ov-brow--top {
    justify-content: space-between;
    gap: 0.6em;
  }
  #dimmer {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--bg);
    opacity: var(--dim-rest);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    #dimmer {
      opacity: var(--dim-rest) !important;
    }
  }
  :root {
    --office-ctl-edge: 10px;
    --office-ctl-w: 36px;
  }
  .office-ctl[hidden] {
    display: none;
  }
  .office-ctl {
    position: fixed;
    right: var(--office-ctl-edge);
    bottom: calc(2rem + env(safe-area-inset-bottom, 0px) + 10px);
    z-index: 50;
    width: var(--office-ctl-w);
    height: var(--office-ctl-w);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: var(--screen);
    border: 2px solid var(--chip-line);
    border-radius: 0;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.45);
    color: var(--chip-bright);
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 0.15s ease;
  }
  /* Footer.astro's row wraps non-monotonically with viewport width, so no flat offset clears it — --footer-h tracks its REAL height, the fallback shows pre-JS only. */
  @media (max-width: 960px) {
    .office-ctl {
      bottom: calc(2rem + env(safe-area-inset-bottom, 0px) + var(--footer-h, 74px) + 10px);
    }
  }
  @media (max-width: 760px) {
    .container {
      padding-inline-end: calc(
        var(--container-pad-x) + var(--office-ctl-edge) + var(--office-ctl-w) + 8px
      );
    }
    .gap-caption {
      max-width: calc(
        100% - var(--gap-caption-inset) - var(--office-ctl-edge) - var(--office-ctl-w) - 8px
      );
    }
  }
  .office-ctl:hover,
  .office-ctl:focus-visible,
  .office-ctl[aria-pressed='true'] {
    opacity: 1;
  }
  .office-ctl:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: 0;
  }
  .office-ctl:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.45);
  }
  .office-ctl svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }
  .office-ctl .office-ctl__play,
  .office-ctl[aria-pressed='true'] .office-ctl__pause {
    display: none;
  }
  .office-ctl[aria-pressed='true'] .office-ctl__play {
    display: block;
    color: var(--led);
  }
  #office-audio {
    bottom: calc(2rem + env(safe-area-inset-bottom, 0px) + 10px + var(--office-ctl-w) + 8px);
  }
  @media (max-width: 960px) {
    #office-audio {
      bottom: calc(
        2rem + env(safe-area-inset-bottom, 0px) + var(--footer-h, 74px) + 10px +
          var(--office-ctl-w) + 8px
      );
    }
  }
  .office-ctl .office-ctl__soundon {
    display: none;
  }
  .office-ctl[aria-pressed='true'] .office-ctl__soundoff {
    display: none;
  }
  .office-ctl[aria-pressed='true'] .office-ctl__soundon {
    display: block;
    color: var(--led);
  }
</style>

<script
  is:inline
  data-wasm-js-url={wasmJsUrl}
  data-audio-worker-url={audioWorkerUrl}
  data-music-worker-url={musicWorkerUrl}
  data-music-worklet-url={musicWorkletUrl}
  data-office-driver-url={officeDriverUrl}
>
  (function () {
    const script = document.currentScript;
    const { wasmJsUrl, audioWorkerUrl, musicWorkerUrl, musicWorkletUrl, officeDriverUrl } =
      script.dataset;

    const wrap = document.querySelector('.backdrop');
    const canvas = document.getElementById('office-live');
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const hasWasm = typeof WebAssembly !== 'undefined';

    // ONE object, not four flat lets: every re-live restarts ALL of them, and a flat set lets a later edit reset three of four.
    function freshReveal() {
      return {
        elapsed: 0, // accumulated from PAINTED frames only
        lastSim: 0,
        ready: 0,
        waited: 0,
      };
    }
    let reveal = freshReveal();
    let splashCleared = !!window.__pixRevealed;
    function cover() {
      canvas.style.opacity = '1';
    }
    function uncover() {
      canvas.style.opacity = '0';
    }
    // A polled flag, not an event: the splash's gate lifts on a RESOLVED boot (up, failed, or unsupported) with no ordering race.
    function markEngineResolved() {
      window.__pixEngineReady = true;
    }
    document.addEventListener('pix:revealed', function () {
      splashCleared = true;
    });
    if (hasWasm && !mq.matches) cover();
    else markEngineResolved();

    const BUF_H = 130;
    const FRAME_MS = 33;
    // ONE office for the whole page (user-pinned): seed 0 is the app's 1F Standard look.
    const SEED = 0;
    const REVEAL_MS = 1600;
    const FLOORS_PAST = 3.2;
    const CHROMA_SPLIT_PX = 3;
    // DERIVED from FRAME_MS, never a second literal: a budget the paint gate could later rise to meet
    // puts EVERY frame over budget, so every reveal takes the MAX_WAIT fallback — green, and untestable.
    const REVEAL_MAX_STEP_MS = Math.round(FRAME_MS * 1.5);
    const REVEAL_READY_FRAMES = 3;
    // A device that never sustains the budget must still get its office: the gate is a courtesy, never a precondition.
    const REVEAL_READY_MAX_WAIT = Math.round(1000 / FRAME_MS);

    let office = null;
    let wasm = null;
    let officeDriver = null;
    let ctx2d = null;
    let img = null;
    let bufW = 0;
    let raf = 0;
    let last = 0;
    let live = false;
    const pauseBtn = document.getElementById('office-pause');
    let paused = false;
    let pauseOffset = 0;
    let pausedAt = 0;

    // Sprites are fixed-size, so a smaller buffer IS zoom — deliberately a closer camera than the app's.
    function sizeBuffer() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      if (w < 1 || h < 1) return;
      bufW = Math.min(640, Math.max(64, Math.round((w / h) * BUF_H)));
      canvas.width = bufW;
      canvas.height = BUF_H;
      img = new ImageData(bufW, BUF_H);
    }

    const overlayEl = document.getElementById('office-overlay');
    const labelPool = [];
    let boardWrap = null;
    let boardBrand = null;
    let boardStar = null;
    let boardMood = null;
    let boardCtx = null;
    let lastLabelPx = -1;

    function ensureBoard() {
      if (boardWrap) return;
      boardWrap = document.createElement('div');
      boardWrap.className = 'ov-board';
      const top = document.createElement('div');
      top.className = 'ov-brow ov-brow--top';
      boardBrand = document.createElement('span');
      boardStar = document.createElement('span');
      top.appendChild(boardBrand);
      top.appendChild(boardStar);
      boardMood = document.createElement('div');
      boardMood.className = 'ov-brow';
      boardCtx = document.createElement('div');
      boardCtx.className = 'ov-brow';
      boardWrap.appendChild(top);
      boardWrap.appendChild(boardMood);
      boardWrap.appendChild(boardCtx);
      overlayEl.appendChild(boardWrap);
    }

    // Segment counts vary with the office's mood/context, so rebuild, not diff.
    function setSegments(rowEl, segs) {
      while (rowEl.firstChild) rowEl.removeChild(rowEl.firstChild);
      for (let i = 0; i < segs.length; i++) {
        const s = document.createElement('span');
        s.textContent = segs[i].text; // textContent, never innerHTML (agent cwds are untrusted)
        if (segs[i].lamp) {
          s.className = 'ov-lamp';
          s.style.setProperty('--lamp', segs[i].color);
        } else {
          s.style.color = segs[i].color;
        }
        rowEl.appendChild(s);
      }
    }

    // object-fit:cover mapping: scale = max(disp/buf) — cover fills then crops, buffer centered.
    function coverMap() {
      const r = canvas.getBoundingClientRect();
      const s = Math.max(r.width / bufW, r.height / BUF_H);
      return { s, ox: r.left + (r.width - bufW * s) / 2, oy: r.top + (r.height - BUF_H * s) / 2 };
    }

    function updateOverlay() {
      if (bufW < 1) return;
      const data = JSON.parse(office.overlay_json());
      const map = coverMap();
      // Written as a shared CSS var, not per-span, so the labels don't each
      // reflow every frame.
      const labelPx = Math.max(9, Math.min(20, map.s * 2.2));
      if (labelPx !== lastLabelPx) {
        lastLabelPx = labelPx;
        overlayEl.style.setProperty('--ov-label-px', labelPx + 'px');
      }
      const labels = data.labels;
      const lift = Math.max(2, map.s); // ~1 buffer px above the head-top
      let i = 0;
      for (; i < labels.length; i++) {
        let el = labelPool[i];
        if (!el) {
          el = document.createElement('span');
          el.className = 'ov-label';
          // Two fixed child spans (● dot, then the name): their textContent concatenates to
          // the full label, so hit-tests and text assertions read it unchanged.
          for (let k = 0; k < 2; k++) el.appendChild(document.createElement('span'));
          overlayEl.appendChild(el);
          labelPool[i] = el;
        }
        const L = labels[i];
        const key = L.text + '\u0000' + L.color + '\u0000' + L.badge;
        if (el._k !== key) {
          el._k = key;
          const parts = el.children;
          parts[0].textContent = L.text.slice(0, 1); // ● dot, drawn as the plate's strip
          parts[1].textContent = L.text.slice(1);
          parts[0].className = 'ov-strip';
          parts[0].style.backgroundColor = L.color;
          parts[1].style.color = L.badge;
        }
        const x = map.ox + L.x * map.s;
        const y = map.oy + L.y * map.s - lift;
        el.style.transform = 'translate(' + x + 'px,' + y + 'px) translate(-50%,-100%)';
        if (el._hidden) {
          el.style.display = '';
          el._hidden = false;
        }
      }
      for (; i < labelPool.length; i++) {
        if (!labelPool[i]._hidden) {
          labelPool[i].style.display = 'none';
          labelPool[i]._hidden = true;
        }
      }
      const b = data.board;
      if (!b) {
        if (boardWrap) boardWrap.style.display = 'none';
        return;
      }
      ensureBoard();
      const bx = map.ox + b.rect.x * map.s;
      const by = map.oy + b.rect.y * map.s;
      const bw = b.rect.w * map.s;
      const bh = b.rect.h * map.s;
      boardWrap.style.display = 'flex';
      boardWrap.style.transform = 'translate(' + bx + 'px,' + by + 'px)';
      boardWrap.style.width = bw + 'px';
      boardWrap.style.height = bh + 'px';
      boardWrap.style.fontSize = Math.max(4, (bh / 3) * 0.82) + 'px';
      boardBrand.textContent = b.brand.text;
      boardBrand.style.color = b.brand.color;
      boardStar.textContent = b.star.text;
      boardStar.style.color = b.star.color;
      setSegments(boardMood, b.mood);
      setSegments(boardCtx, b.context);
    }

    function paint(nowMs) {
      if (!img) return;
      office.step(nowMs, bufW, BUF_H);
      // Re-read ptr/len every frame — resize and memory.grow move the frame view.
      const view = officeDriver.officeFrameView(office, wasm);
      markEngineResolved();
      // Hold on the bg-tone cover until the boot splash lifts: the roll is never played hidden behind the overlay.
      if (!splashCleared) return;
      const step = reveal.lastSim ? nowMs - reveal.lastSim : 0;
      reveal.lastSim = nowMs;
      const onBudget = step > 0 && step <= REVEAL_MAX_STEP_MS;
      // Under reduced motion the office is a poster-still — no stray repaint (a resize, a background tick) may undo the mq listener's de-live.
      if (!live && !mq.matches) {
        // Frames must flow before the roll starts: a stall holds on the flat bg tone, and `is-live` / pix:onair / the ♩ button are deferred, so an office about to freeze never announces itself live.
        reveal.ready = onBudget ? reveal.ready + 1 : 0;
        reveal.waited++;
        if (reveal.ready < REVEAL_READY_FRAMES && reveal.waited < REVEAL_READY_MAX_WAIT) return;
        live = true;
        wrap.classList.add('is-live');
        document.dispatchEvent(new CustomEvent('pix:onair', { detail: { live: true } }));
        showAudioBtn();
      }
      // Safari blocks the main thread for over a second inside its tab-snapshot IPC, so the roll rides PAINTED
      // frames: the clamp makes a hitch PAUSE it, and Date.now()'s backward jumps hold it rather than rewind.
      reveal.elapsed += Math.max(0, Math.min(step, REVEAL_MAX_STEP_MS));
      const rt = mq.matches ? 1 : reveal.elapsed / REVEAL_MS;
      if (rt < 1) {
        drawRevealFrame(view, rt < 0 ? 0 : rt);
      } else {
        img.data.set(view);
        ctx2d.putImageData(img, 0, 0);
        // Caption the settled office only: labels track the FINAL sprite positions, so they'd smear over the rolling floors.
        updateOverlay();
        overlayEl.classList.add('is-on');
      }
    }
    // putImageData writes the sub-1 alpha straight to the canvas, so the
    // element's own bg (var(--bg)) shows through the transparent pixels.
    function drawRevealFrame(view, rt) {
      const w = bufW;
      const h = BUF_H;
      const d = img.data;
      const e = 1 - Math.pow(1 - rt, 4);
      const roll = Math.round((1 - e) * h * FLOORS_PAST);
      const alpha = Math.min(1, rt / 0.15);
      const split = Math.round((1 - e) * CHROMA_SPLIT_PX);
      for (let y = 0; y < h; y++) {
        const sy = (y + roll) % h;
        const seam = sy < 1 || sy > h - 2 ? 0.3 : 1; // floor divider: more bg shows
        const a = alpha * seam * 255;
        const row = sy * w;
        for (let x = 0; x < w; x++) {
          const o = (y * w + x) * 4;
          const xr = split ? (x + split < w ? x + split : w - 1) : x;
          const xb = split ? (x - split >= 0 ? x - split : 0) : x;
          d[o] = view[(row + xr) * 4];
          d[o + 1] = view[(row + x) * 4 + 1];
          d[o + 2] = view[(row + xb) * 4 + 2];
          d[o + 3] = a;
        }
      }
      ctx2d.putImageData(img, 0, 0);
    }

    function frame(t) {
      raf = 0;
      if (document.hidden) return;
      if (t - last >= FRAME_MS) {
        last = t;
        // Date.now(), NOT the rAF timestamp: the engine decodes now_ms as calendar time (browser-local day/night).
        const nowMs = Date.now() - pauseOffset;
        paint(nowMs);
        // Ticks AFTER paint, on the same sim clock: office.step has set the frame's clock the AudioFrame reads.
        audioTick(nowMs);
      }
      raf = requestAnimationFrame(frame);
    }
    function start() {
      if (!raf && office && !document.hidden && !mq.matches && !paused) {
        raf = requestAnimationFrame(frame);
      }
    }
    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }
    // pauseOffset resumes from the frozen moment; tab-hidden stops take NO offset on purpose — the office keeps living while you're away.
    function setPaused(p) {
      paused = p;
      pauseBtn.setAttribute('aria-pressed', String(p));
      // WCAG 2.2.2 covers the page, not just this canvas — ONE control fans out to every other auto-motion surface.
      document.dispatchEvent(new CustomEvent('pix:paused', { detail: { paused: p } }));
      if (audioCtx && audioPlaying) {
        if (p) audioCtx.suspend();
        else audioCtx.resume();
      }
      if (p) {
        pausedAt = Date.now();
        stop();
      } else {
        pauseOffset += Date.now() - pausedAt;
        start();
      }
    }
    pauseBtn.addEventListener('click', function () {
      setPaused(!paused);
    });
    // The pause control governs the page's wasm-independent ambient motion via pix:paused, so it stays reachable on a no-wasm engine or a failed fetch (#456).
    function syncPauseBtn() {
      pauseBtn.hidden = mq.matches;
    }
    syncPauseBtn();

    // The engine records per-tick gain/play commands (office.audio_tick) and JS is dumb glue — the mixing decisions all live in Rust.
    const audioBtn = document.getElementById('office-audio');
    const AUDIO_PREF = 'pix:audio';
    let audioCtx = null;
    let audioBus = null;
    let audioReady = false;
    let audioPlaying = false;
    let audioBooting = false;
    let audioUnavailable = false;
    let restoreArmed = false;
    let loopGains = [];
    let oneShotBufs = {};
    let audioSR = 44100;
    let gainDezipperS = 0;

    // Copy OUT of wasm memory before the next memory.grow detaches the view — audioSR is a param so no wasm call splits the view from the copy.
    function audioMakeBuffer(ptr, len) {
      if (!len) return null;
      const view = new Float32Array(wasm.memory.buffer, ptr, len);
