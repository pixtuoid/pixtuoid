---
// ONE gen-media render (scripts/media.json job `proof`) drives BOTH sides —
// the typed session AND the real-renderer office — burned into a single clip,
// so the halves can never desync. The tall clip is that same render composed
// vertically.
import { asset } from '../consts';
---

{/* role="region": a bare div's implicit role (generic) PROHIBITS an
  accessible name per WAI-ARIA 1.2, so the aria-label would be dropped. */}
<div class="proof" id="proof" role="region" aria-label="proof: a real session drives the office">
  <div class="proof__stage hw-panel">
    {/* Both variants ship [hidden] with a data-poster: a browser fetches a
      <video poster> even on a hidden element, so an eager `poster=` bills the
      visitor for a section screens below the fold — a narrow one for BOTH
      variants. width/height (the posters' own, pinned by
      config/proof-poster-dims.demos.mjs) hold the box's aspect until the poster
      lands — without them the section grows mid-scroll and every in-page jump
      below it lands short. */}
    <video
      class="proof__video proof__video--wide px"
      width="1720"
      height="902"
      hidden
      muted
      loop
      playsinline
      preload="none"
      data-poster={asset('demos/proof-poster.png')}
      data-webm={asset('demos/proof.webm')}
      data-mp4={asset('demos/proof.mp4')}
      aria-label="split screen: a Claude Code session types on the left; on the right the pixel office reacts — a sprite walks in, its monitor lights per tool call"
    ></video>
    <video
      class="proof__video proof__video--tall px"
      width="960"
      height="1334"
      hidden
      muted
      loop
      playsinline
      preload="none"
      data-poster={asset('demos/proof-tall-poster.png')}
      data-webm={asset('demos/proof-tall.webm')}
      data-mp4={asset('demos/proof-tall.mp4')}
      aria-label="the same replay stacked vertically: the session above, the office below"
    ></video>
    <noscript>
      <img
        class="proof__video px"
        src={asset('demos/proof-poster.png')}
        width="1720"
        height="902"
        decoding="async"
        alt="split screen: a Claude Code session on the left; on the right the pixel office reacts to it"
      />
    </noscript>
  </div>
  <p class="proof__coda">
    <span class="text-scrim">
      this office also pops out as a desktop window → <code>pixtuoid floating</code>
    </span>
  </p>
</div>

<script is:inline>
  // A pix:paused CONSUMER, never a dispatcher — #office-pause is the one
  // control. Under reduced motion we never hydrate, so the active variant's
  // poster must be promoted from data-poster in sync() rather than hydrate() —
  // but only once the section is NEAR (the markup comment owns why).
  (function () {
    const root = document.getElementById('proof');
    const wide = root.querySelector('.proof__video--wide');
    const tall = root.querySelector('.proof__video--tall');
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = window.matchMedia('(max-width: 760px)');
    let userPaused = false;
    let inView = false;
    let near = !('IntersectionObserver' in window);

    function showPoster(v) {
      if (v.dataset.poster) {
        v.poster = v.dataset.poster;
        v.removeAttribute('data-poster');
      }
    }
    function hydrate(v) {
      if (!v.dataset.mp4) return;
      showPoster(v);
      const sw = document.createElement('source');
      sw.src = v.dataset.webm;
      sw.type = 'video/webm';
      v.appendChild(sw);
      const sm = document.createElement('source');
      sm.src = v.dataset.mp4;
      sm.type = 'video/mp4';
      v.appendChild(sm);
      v.removeAttribute('data-webm');
      v.removeAttribute('data-mp4');
      v.load();
    }
    function sync() {
      wide.hidden = narrow.matches;
      tall.hidden = !narrow.matches;
      if (near) showPoster(narrow.matches ? tall : wide);
      [wide, tall].forEach(function (v) {
        if (mq.matches) {
          v.pause();
          return;
        }
        if (!v.hidden && inView && !userPaused) {
          hydrate(v);
          const p = v.play();
          if (p && p.catch) p.catch(function () {});
        } else {
          v.pause();
        }
      });
    }
    if ('IntersectionObserver' in window) {
      // Two viewports of lead: enough for a scroll on a slow link. A JUMP to
      // the section still meets the bare panel until the poster lands.
      const nearIO = new IntersectionObserver(
        function (entries) {
          if (!entries[0].isIntersecting) return;
          near = true;
          nearIO.disconnect();
          sync();
        },
        { rootMargin: '200% 0px' }
      );
      nearIO.observe(root);
      new IntersectionObserver(
        function (entries) {
          inView = entries[0].isIntersecting;
          sync();
        },
        { threshold: 0.2 }
      ).observe(root);
    } else {
      inView = true;
      sync();
    }
    document.addEventListener('pix:paused', function (e) {
      userPaused = !!(e.detail && e.detail.paused);
      sync();
    });
    if (narrow.addEventListener) narrow.addEventListener('change', sync);
    if (mq.addEventListener) mq.addEventListener('change', sync);
    sync();
  })();
</script>

<style>
  /* Width comes from the parent .container's content box so the stage, the
     eyebrow above, and the coda share ONE left edge. Don't re-introduce a
     self-centering min() here — that is a second alignment system. */
  .proof {
    position: relative;
    padding: clamp(3rem, 8vh, 6rem) 0;
    display: grid;
    justify-items: start;
    gap: 1.1rem;
  }
  .proof__stage {
    width: 100%;
  }
  .proof__video {
    display: block;
    width: 100%;
    height: auto;
  }
  .proof__video[hidden] {
    display: none;
  }
  .proof__coda {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg); /* var(--fg)=var(--ink): AA in both day + night themes */
  }
  .proof__coda code {
    color: var(--grad-2);
  }
  .proof__video:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }
</style>
