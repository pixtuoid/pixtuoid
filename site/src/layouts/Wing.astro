---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Statusline from '../components/Statusline.astro';
import { asset, floorHref, pageTitle, type Wing, type WingPage } from '../consts';
import { FLOORS } from '../../config/floors.mjs';
import { REPO_BLOB } from '../../config/github.mjs';

interface Props {
  wing: Wing;
  // The wing's page this is; its lobby, which lists them, is none of them.
  page?: WingPage;
  title: string;
  description: string;
  headings?: MarkdownHeading[];
  // The repository file the page renders verbatim, and what its source line adds about how.
  source?: { path: string; note?: string };
}

const { wing, page, title, description, headings = [], source } = Astro.props;

// The lobby lists the wing's pages; it is no article of its own.
const Body = page ? 'article' : 'div';

const idx = page ? wing.pages.indexOf(page) : -1;
const prev = idx > 0 ? wing.pages[idx - 1] : undefined;
const next = idx >= 0 && idx < wing.pages.length - 1 ? wing.pages[idx + 1] : undefined;

// h2 sections, folding in h3s when a doc has few. Trailing parentheticals are
// stripped so a long heading doesn't wrap to three lines in the rail.
const h2s = headings.filter((h) => h.depth === 2);
const raw = h2s.length < 3 ? headings.filter((h) => h.depth === 2 || h.depth === 3) : h2s;
const toc = raw.map((h) => ({ ...h, text: h.text.replace(/\s*\([^)]*\)\s*$/, '') }));
---

<Base title={pageTitle(title)} description={description}>
  <Nav />
  <main id="main" tabindex="-1" class="wing">
    <nav class="wing__rail wing__sidebar hw-panel" aria-label={wing.name}>
      <p class="wing__bank">elevator — {wing.bank}</p>
      <ul class="wing__list">
        {wing.pages.map((d) => <li>
          <a href={asset(d.route)} aria-current={d === page ? 'page' : undefined}>
            <span
              class:list={['led-dot', { 'led-selected': d === page, 'is-on': d === page }]}
              aria-hidden="true"
            />
            {d.label}
          </a>
        </li>)}
      </ul>
      <p class="wing__bank">the building</p>
      <ul class="wing__list wing__list--building">
        {FLOORS.map((f) => <li>
          <a href={floorHref(f.id)}>
            <span class="wing__fl" aria-hidden="true">
              {f.fl}
            </span>
            {f.label}
          </a>
        </li>)}
      </ul>
    </nav>

    <div class="wing__body">
      <Body class="prose">
        <slot />
      </Body>

      {(prev || next) && <nav class="wing__pager" aria-label={`${wing.name} pagination`}>
        {prev ? (
          <a class="wing__pager-link" href={asset(prev.route)} rel="prev">
            <span class="wing__pager-dir" aria-hidden="true"> ← {wing.turns.back} </span>
            {prev.label}
          </a>
        ) : (
          <span />
        )}
        {next && <a
          class="wing__pager-link wing__pager-link--next"
          href={asset(next.route)}
          rel="next"
        >
          <span class="wing__pager-dir" aria-hidden="true"> {wing.turns.on} → </span>
          {next.label}
        </a>}
      </nav>}

      {source && <p class="wing__source">
        Source of truth:
        <a href={`${REPO_BLOB}/${source.path}`} target="_blank" rel="noreferrer">
          {source.path}
        </a>
        — this page renders it verbatim{source.note && ` (${source.note})`}.
      </p>}
    </div>

    {toc.length > 0 && <nav class="wing__rail wing__toc" aria-label="On this page">
      <p class="wing__toc-label">on this page</p>
      <ul class="wing__list">
        {toc.map((h) => <li class={h.depth === 3 ? 'wing__toc-sub' : undefined}>
          <a href={`#${h.slug}`} data-toc-link={h.slug}>
            {h.text}
          </a>
        </li>)}
      </ul>
    </nav>}
  </main>
  <Footer />
  <Statusline wingPath={wing.path} pageSlug={page?.route.replace(/\/$/, '').split('/').pop()} />
</Base>

<script is:inline>
  // Scrollspy: light the TOC entry whose heading crosses the upper reading band.
  (function () {
    const links = document.querySelectorAll('[data-toc-link]');
    if (!links.length || !('IntersectionObserver' in window)) return;
    const bySlug = {};
    links.forEach(function (a) {
      bySlug[a.dataset.tocLink] = a;
    });
    function setActive(slug) {
      links.forEach(function (a) {
        if (a.dataset.tocLink === slug) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    }
    const io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting && bySlug[e.target.id]) setActive(e.target.id);
        });
      },
      { rootMargin: '-15% 0px -75% 0px', threshold: 0 }
    );
    Object.keys(bySlug).forEach(function (slug) {
      const h = document.getElementById(slug);
      if (h) io.observe(h);
    });
    // An INSTANT jump (reduced-motion click, deep-linked #anchor load) parks the
    // heading above the band, so no entry fires — sync explicitly instead.
    links.forEach(function (a) {
      a.addEventListener('click', function () {
        setActive(a.dataset.tocLink);
      });
    });
    const fromHash = location.hash.slice(1);
    if (fromHash && bySlug[fromHash]) setActive(fromHash);
  })();
</script>

<style>
  .wing {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.1rem, 4vw, 2.5rem) clamp(3rem, 7vw, 5rem);
    display: grid;
    grid-template-columns: 13rem minmax(0, 820px) 13rem;
    gap: clamp(1.4rem, 3vw, 3rem);
    justify-content: center;
    align-items: start;
  }
  /* anchored headings clear the sticky nav, and park nearer the scrollspy band */
  .wing :global(.prose h2),
  .wing :global(.prose h3) {
    scroll-margin-top: calc(var(--nav-h) + 1.5rem);
  }
  .wing__rail {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }
  .wing__toc-label {
    font-weight: 700;
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 0.8rem;
  }
  .wing__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .wing__list a {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
  }
  .wing__list a:hover {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 5%, transparent);
  }
  /* the sidebar is HARDWARE (.hw-panel): chip-palette ink, and the current doc
     reads as a lit LED rather than the paper-coral current-page tint */
  .wing__sidebar {
    padding: 0.8rem 0.55rem;
    color: var(--chip-ink);
  }
  .wing__bank {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--chip-dim);
    margin: 0 0 0.5rem 0.6rem;
  }
  .wing__list--building {
    margin-top: 1.3rem;
  }
  .wing__sidebar a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--chip-ink);
  }
  .wing__sidebar a:hover {
    color: var(--chip-bright);
    background: var(--hw-hover);
  }
  .wing__sidebar a[aria-current='page'] {
    color: var(--led);
    background: var(--hw-hover);
    border-left-color: var(--led);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }
  .wing__fl {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--chip-dim);
    min-width: 1.5rem;
  }
  .wing__sidebar a:hover .wing__fl,
  .wing__sidebar a[aria-current='page'] .wing__fl {
    color: inherit;
  }
  /* rendered markdown carries no astro scope hash, hence :global throughout */
  /* One terminal chrome for a callout and a figure in a window (config/rehype-figures.mjs's
     `figure`). */
  .wing :global(:is(.callout, .fig--window)) {
    margin: 1.4rem 0;
    background: var(--screen);
    border: 1px solid var(--chip-line);
  }
  .wing :global(:is(.callout__bar, .fig__bar)) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid var(--chip-line);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--chip-dim);
  }
  /* The padding is the body's, so the svg's min-width bounds exactly what beautiful-mermaid drew. */
  .wing :global(.fig__body) {
    overflow-x: auto;
    padding: 1.1rem;
  }
  /* The library's hooks read the cascade: the diagram's ground is the screen,
     and its text, fills and strokes take the chip tones that clear AA and a
     box's 3:1 on it (smoke.spec.ts's diagram tests grade both). */
  .wing :global(.fig--diagram svg) {
    --bg: var(--screen);
    --fg: var(--chip-bright);
    --surface: var(--hw-hover);
    --muted: var(--chip-ink);
    --border: var(--chip-dim);
    display: block;
    width: 100%;
    height: auto;
    background: var(--bg);
  }
  .wing :global(.fig__end > :is(rect, polygon, path, circle, ellipse)) {
    stroke: var(--amber);
    stroke-width: 1.5;
  }
  .wing :global(.fig__cards) {
    display: grid;
    /* min(): at an enlarged font size a card is no wider than the column it sits in. */
    grid-template-columns: repeat(auto-fill, minmax(min(15.5rem, 100%), 1fr));
    gap: 0.9rem;
    margin: 1.8rem 0;
    padding: 0;
    list-style: none;
  }
  .wing :global(.fig-card) {
    margin: 0;
    padding: 1rem 1.1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
  }
  .wing :global(.fig-card__role) {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.1;
    color: var(--fg);
  }
  /* (0,4,1), past global.css's theme-prefixed `.prose a` (0,3,1), which tints
     night's and dracula's links: a role's name reads as the card's title. */
  .wing :global(.fig-card .fig-card__role a) {
    color: inherit;
    font-weight: inherit;
  }
  .wing :global(.fig-card__acts) {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .wing :global(:is(.fig__budgets, .fig__panes)) {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wing :global(:is(.fig-budget, .fig-pane) p) {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--chip-bright);
  }
  .wing :global(.fig-budget) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 0.8rem;
    margin: 0;
  }
  .wing :global(.fig-budget__line) {
    grid-column: 1 / -1;
    display: block;
    width: 100%;
    height: 2rem;
  }
  .wing :global(.fig-budget__run) {
    fill: var(--chip-ink);
  }
  .wing :global(.fig-budget__run--late) {
    fill: var(--chip-accent);
  }
  .wing :global(.fig-budget__beat) {
    stroke: var(--chip-bright);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .wing :global(.fig-budget__now) {
    fill: var(--led);
  }
  .wing :global(.reveal.in .fig-budget__now) {
    animation: fig-now 4s linear;
  }
  @keyframes fig-now {
    to {
      transform: translateX(100%);
    }
  }
  .wing :global(.fig__panes) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .wing :global(.fig-pane svg) {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 0.6rem;
  }
  .wing :global(.fig-pane__frame) {
    fill: var(--hw-hover);
    stroke: var(--chip-dim);
    stroke-width: 0.5;
  }
  .wing :global(.fig-pane__desk) {
    fill: var(--chip-line);
  }
  .wing :global(.fig-pane__change) {
    fill: var(--chip-accent);
  }
  .wing :global(.fig-pane__box) {
    fill: none;
    stroke: var(--led);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .wing :global(.fig-pane__cuts) {
    fill: none;
    stroke: var(--chip-accent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .wing :global(.fig-pane__wash) {
    fill: var(--chip-accent);
    opacity: 0.7;
    transform-box: fill-box;
    transform-origin: top;
  }
  .wing :global(.reveal.in .fig-pane__wash) {
    animation: fig-wash 1.8s ease-in-out 2;
  }
  @keyframes fig-wash {
    from {
      transform: scaleY(0);
    }
    55% {
      transform: none;
      opacity: 0.7;
    }
    to {
      opacity: 0;
    }
  }
  .wing :global(p.fig-pane__count) {
    font-family: var(--font-display);
    font-size: 1.5rem;
  }
  /* A playhead that will not run marks no instant. */
  @media (prefers-reduced-motion: reduce), (scripting: none) {
    .wing :global(.fig-budget__now) {
      display: none;
    }
  }
  .wing :global(.callout__body) {
    margin: 0;
    padding: 0.9rem 1.1rem;
    border: 0;
    color: var(--chip-ink);
  }
  /* global.css's `.prose p, .prose li` matches these DIRECTLY, which beats the
     --chip-ink their .callout__body ancestor hands down — dark ink on the dark
     --screen. Astro compiles `.wing :global(…)` to (0,3,1), which beats
     `.prose p` (0,1,1) by WEIGHT. CAVEAT: a THEME-prefixed global rule
     (`:root[data-theme='night'] .prose a`) is ALSO (0,3,1), an exact tie the
     twins below win only on source order — see the `a > code` rule. */
  .wing :global(.callout__body p),
  .wing :global(.callout__body li) {
    color: inherit;
  }
  .wing :global(.callout__body a) {
    color: var(--chip-bright);
  }
  .wing :global(.callout__body code) {
    color: var(--chip-bright);
    background: var(--hw-hover);
  }
  /* Twin for global.css's `.prose a > code` plate swap, which at (0,3,2)
     OUTWEIGHS the rule above — a link-wrapped chip in a callout wore --surface
     next to its --hw-hover siblings. The extra `.callout` takes this to (0,4,2)
     so it wins on WEIGHT: a plain twin would only tie. */
  .wing :global(.callout .callout__body a > code) {
    background: var(--hw-hover);
  }
  /* --coral-deep is theme-retuned, so this needs no per-theme override */
  .wing__toc a[aria-current='location'] {
    color: var(--coral-deep);
    border-left-color: var(--coral-deep);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }
  .wing__toc-sub a {
    padding-left: 1.4rem;
  }
  .wing__pager {
    display: flex;
    /* At 320px the longest neighbour pair outgrows one row. */
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.6rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.92rem;
  }
  .wing__pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--fg);
    text-decoration: none;
  }
  .wing__pager-link--next {
    text-align: right;
    margin-left: auto;
  }
  .wing__pager-link:hover {
    border-color: var(--border-strong);
    color: var(--coral-deep);
  }
  .wing__pager-dir {
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .wing__source {
    margin-top: 2.6rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--fg-muted);
  }
  /* No room for the rails: Nav's Docs dropdown lists the docs, and a post's meta line links
     the blog. */
  @media (max-width: 1000px) {
    .wing {
      display: block;
      max-width: 820px;
    }
    .wing__rail {
      display: none;
    }
  }
</style>
