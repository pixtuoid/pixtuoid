---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Statusline from '../components/Statusline.astro';
import { posix } from 'node:path';
import { asset, DOCS, FLOORS, type DocId } from '../consts';
import { REPO_BLOB } from '../../config/github.mjs';

interface Props {
  title: string;
  description: string;
  headings: MarkdownHeading[];
  current: DocId;
  /** The rendered collection entry, whose file the source line links. */
  entry: { filePath?: string };
  sourceNote?: string;
}

const {
  title,
  description,
  headings,
  current,
  entry,
  sourceNote = 'this page renders it verbatim.',
} = Astro.props;

// The glob loader keeps `filePath` relative to the project root (site/), which sits in the repo root.
if (!entry.filePath) throw new Error(`Docs.astro: the "${current}" entry carries no filePath`);
const sourcePath = posix.relative('..', entry.filePath);

const idx = DOCS.findIndex((d) => d.id === current);
const prev = idx > 0 ? DOCS[idx - 1] : undefined;
const next = idx < DOCS.length - 1 ? DOCS[idx + 1] : undefined;

// h2 sections, folding in h3s when a doc has few. Trailing parentheticals are
// stripped so a long heading doesn't wrap to three lines in the 13rem rail.
const h2s = headings.filter((h) => h.depth === 2);
const raw = h2s.length < 3 ? headings.filter((h) => h.depth === 2 || h.depth === 3) : h2s;
const toc = raw.map((h) => ({ ...h, text: h.text.replace(/\s*\([^)]*\)\s*$/, '') }));
---

<Base title={title} description={description}>
  <Nav />
  <main id="main" tabindex="-1" class="docs">
    <nav class="docs__rail docs__sidebar hw-panel" aria-label="Docs">
      <p class="docs__bank">elevator — docs wing</p>
      <ul class="docs__list">
        {DOCS.map((d) => <li>
          <a href={asset(d.route)} aria-current={d.id === current ? 'page' : undefined}>
            <span
              class:list={[
                'led-dot',
                { 'led-selected': d.id === current, 'is-on': d.id === current },
              ]}
              aria-hidden="true"
            />
            {d.label}
          </a>
        </li>)}
      </ul>
      <p class="docs__bank">the building</p>
      <ul class="docs__list docs__list--building">
        {FLOORS.map((f) => <li>
          <a href={`${asset('')}#${f.id}`}>
            <span class="docs__fl" aria-hidden="true">
              {f.fl}
            </span>
            {f.label}
          </a>
        </li>)}
      </ul>
    </nav>

    <div class="docs__body">
      <article class="prose">
        <slot />
      </article>

      <nav class="docs__pager" aria-label="Docs pagination">
        {prev ? (
          <a class="docs__pager-link" href={asset(prev.route)} rel="prev">
            <span class="docs__pager-dir" aria-hidden="true"> ← previous </span>
            {prev.label}
          </a>
        ) : (
          <span />
        )}
        {next && <a
          class="docs__pager-link docs__pager-link--next"
          href={asset(next.route)}
          rel="next"
        >
          <span class="docs__pager-dir" aria-hidden="true"> next → </span>
          {next.label}
        </a>}
      </nav>

      <p class="docs__source">
        Source of truth:
        <a href={`${REPO_BLOB}/${sourcePath}`} target="_blank" rel="noreferrer">
          {sourcePath}
        </a>
        — {sourceNote}
      </p>
    </div>

    {toc.length > 0 && <nav class="docs__rail docs__toc" aria-label="On this page">
      <p class="docs__toc-label">on this page</p>
      <ul class="docs__list">
        {toc.map((h) => <li class={h.depth === 3 ? 'docs__toc-sub' : undefined}>
          <a href={`#${h.slug}`} data-toc-link={h.slug}>
            {h.text}
          </a>
        </li>)}
      </ul>
    </nav>}
  </main>
  <Footer />
  <Statusline doc={current} />
</Base>

<script is:inline>
  // Scrollspy: light the TOC entry whose heading crosses the upper reading band.
  (function () {
    const links = document.querySelectorAll('[data-toc-link]');
    if (!links.length || !('IntersectionObserver' in window)) return;
    const bySlug = {};
    links.forEach(function (a) {
      bySlug[a.dataset.tocLink] = a;
    });
    function setActive(slug) {
      links.forEach(function (a) {
        if (a.dataset.tocLink === slug) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    }
    const io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting && bySlug[e.target.id]) setActive(e.target.id);
        });
      },
      { rootMargin: '-15% 0px -75% 0px', threshold: 0 }
    );
    Object.keys(bySlug).forEach(function (slug) {
      const h = document.getElementById(slug);
      if (h) io.observe(h);
    });
    // An INSTANT jump (reduced-motion click, deep-linked #anchor load) parks the
    // heading above the band, so no entry fires — sync explicitly instead.
    links.forEach(function (a) {
      a.addEventListener('click', function () {
        setActive(a.dataset.tocLink);
      });
    });
    const fromHash = location.hash.slice(1);
    if (fromHash && bySlug[fromHash]) setActive(fromHash);
  })();
</script>

<style>
  .docs {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.1rem, 4vw, 2.5rem) clamp(3rem, 7vw, 5rem);
    display: grid;
    grid-template-columns: 13rem minmax(0, 820px) 13rem;
    gap: clamp(1.4rem, 3vw, 3rem);
    justify-content: center;
    align-items: start;
  }
  /* anchored headings clear the sticky nav, and park nearer the scrollspy band */
  .docs :global(.prose h2),
  .docs :global(.prose h3) {
    scroll-margin-top: calc(var(--nav-h) + 1.5rem);
  }
  .docs__rail {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }
  .docs__toc-label {
    font-weight: 700;
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 0.8rem;
  }
  .docs__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .docs__list a {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
  }
  .docs__list a:hover {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 5%, transparent);
  }
  /* the sidebar is HARDWARE (.hw-panel): chip-palette ink, and the current doc
     reads as a lit LED rather than the paper-coral current-page tint */
  .docs__sidebar {
    padding: 0.8rem 0.55rem;
    color: var(--chip-ink);
  }
  .docs__bank {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--chip-dim);
    margin: 0 0 0.5rem 0.6rem;
  }
  .docs__list--building {
    margin-top: 1.3rem;
  }
  .docs__sidebar a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--chip-ink);
  }
  .docs__sidebar a:hover {
    color: var(--chip-bright);
    background: var(--hw-hover);
  }
  .docs__sidebar a[aria-current='page'] {
    color: var(--led);
    background: var(--hw-hover);
    border-left-color: var(--led);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }
  .docs__fl {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--chip-dim);
    min-width: 1.5rem;
  }
  .docs__sidebar a:hover .docs__fl,
  .docs__sidebar a[aria-current='page'] .docs__fl {
    color: inherit;
  }
  /* rendered markdown carries no astro scope hash, hence :global throughout */
  .docs :global(.callout) {
    margin: 1.4rem 0;
    background: var(--screen);
    border: 1px solid var(--chip-line);
  }
  .docs :global(.callout__bar) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid var(--chip-line);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--chip-dim);
  }
  .docs :global(.callout__body) {
    margin: 0;
    padding: 0.9rem 1.1rem;
    border: 0;
    color: var(--chip-ink);
  }
  /* global.css's `.prose p, .prose li` matches these DIRECTLY, which beats the
     --chip-ink their .callout__body ancestor hands down — dark ink on the dark
     --screen. Astro compiles `.docs :global(…)` to (0,3,1), which beats
     `.prose p` (0,1,1) by WEIGHT. CAVEAT: a THEME-prefixed global rule
     (`:root[data-theme='night'] .prose a`) is ALSO (0,3,1), an exact tie the
     twins below win only on source order — see the `a > code` rule. */
  .docs :global(.callout__body p),
  .docs :global(.callout__body li) {
    color: inherit;
  }
  .docs :global(.callout__body a) {
    color: var(--chip-bright);
  }
  .docs :global(.callout__body code) {
    color: var(--chip-bright);
    background: var(--hw-hover);
  }
  /* Twin for global.css's `.prose a > code` plate swap, which at (0,3,2)
     OUTWEIGHS the rule above — a link-wrapped chip in a callout wore --surface
     next to its --hw-hover siblings. The extra `.callout` takes this to (0,4,2)
     so it wins on WEIGHT: a plain twin would only tie. */
  .docs :global(.callout .callout__body a > code) {
    background: var(--hw-hover);
  }
  /* --coral-deep is theme-retuned, so this needs no per-theme override */
  .docs__toc a[aria-current='location'] {
    color: var(--coral-deep);
    border-left-color: var(--coral-deep);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }
  .docs__toc-sub a {
    padding-left: 1.4rem;
  }
  .docs__pager {
    display: flex;
    /* At 320px the longest neighbour pair outgrows one row. */
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.6rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.92rem;
  }
  .docs__pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--fg);
    text-decoration: none;
  }
  .docs__pager-link--next {
    text-align: right;
    margin-left: auto;
  }
  .docs__pager-link:hover {
    border-color: var(--border-strong);
    color: var(--coral-deep);
  }
  .docs__pager-dir {
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .docs__source {
    margin-top: 2.6rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--fg-muted);
  }
  /* rails hidden — Nav's Docs dropdown covers them */
  @media (max-width: 1000px) {
    .docs {
      display: block;
      max-width: 820px;
    }
    .docs__rail {
      display: none;
    }
  }
</style>
