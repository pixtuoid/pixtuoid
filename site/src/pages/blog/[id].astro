---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import Wing from '../../layouts/Wing.astro';
import { blogWing, postDay, posts } from '../../blog';
import { asset } from '../../consts';
import { BLOG_DIR, BLOG_ROUTE, postRoute } from '../../../config/blog.mjs';

export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post } = Astro.props as Props;
const { Content, headings } = await render(post);
const wing = await blogWing();
---

<Wing
  wing={wing}
  page={wing.pages.find((page) => page.route === postRoute(post.id))}
  title={post.data.title}
  description={post.data.description}
  headings={headings}
  source={{ path: `site/${BLOG_DIR}/${post.id}.md` }}
>
  <p class="post__meta">
    <a href={asset(BLOG_ROUTE)}>Blog</a> · <time datetime={postDay(post)}>{postDay(post)}</time>
  </p>
  <h1>{post.data.title}</h1>
  <p class="post__lede">{post.data.description}</p>
  <Content />
</Wing>

<style>
  .post__meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-muted);
  }
  .post__lede {
    margin-bottom: 1.4rem;
    font-size: 1.15rem;
    color: var(--fg-muted);
  }
</style>
