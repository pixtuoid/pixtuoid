---
import type { InferGetStaticPropsType } from 'astro';
import { getEntry, render } from 'astro:content';
import Docs from '../layouts/Docs.astro';
import { DOCS, docSlug } from '../consts';

export async function getStaticPaths() {
  return Promise.all(
    DOCS.map(async (page) => {
      const entry = await getEntry('docs', page.file);
      if (!entry) {
        throw new Error(
          `[doc].astro: no rendered entry for ${page.file}: is the file present? src/docs.json names it, and feeds the glob loader in content.config.ts.`
        );
      }
      return { params: { doc: docSlug(page) }, props: { page, entry } };
    })
  );
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page, entry } = Astro.props as Props;
const { Content, headings } = await render(entry);
---

<Docs page={page} headings={headings}>
  <Content />
</Docs>
