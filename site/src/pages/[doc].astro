---
import type { InferGetStaticPropsType } from 'astro';
import { getEntry, render } from 'astro:content';
import Wing from '../layouts/Wing.astro';
import { DOCS, DOCS_WING } from '../consts';
import { DOC_DIR, pageName } from '../../config/docs.mjs';

export async function getStaticPaths() {
  return Promise.all(
    DOCS.map(async (page) => {
      const entry = await getEntry('docs', page.file);
      if (!entry) {
        throw new Error(
          `[doc].astro: no rendered entry for ${page.file}: is the file present? src/docs.json names it, and feeds the glob loader in content.config.ts.`
        );
      }
      return { params: { doc: pageName(page) }, props: { page, entry } };
    })
  );
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page, entry } = Astro.props as Props;
const { Content, headings } = await render(entry);
---

<Wing
  wing={DOCS_WING}
  page={page}
  title={page.label}
  description={page.description}
  headings={headings}
  source={{ path: `${DOC_DIR}/${page.file}`, note: page.sourceNote }}
>
  <Content />
</Wing>
