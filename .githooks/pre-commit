#!/usr/bin/env bash
# Pre-commit hook: format check only.
# Everything else: pre-push (`just preflight`) and CI.
#
# Set up once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# No justfile has run yet, so its mise PATH can't supply just.
just=(just)
if ! command -v just &>/dev/null; then
    if command -v mise &>/dev/null; then
        just=(mise exec -- just)
    else
        # shellcheck disable=SC2016  # backticks are literal text, not expansion
        printf '\033[31m[pre-commit] `just` not found — brew install mise, then `mise install`\033[0m\n' >&2
        exit 1
    fi
fi

printf '\033[36m[pre-commit] just fmt-check\033[0m\n' >&2
"${just[@]}" fmt-check || {
    # shellcheck disable=SC2016  # backticks are literal text, not expansion
    printf '\033[31m[pre-commit] FAILED: run `just fmt` and recommit\033[0m\n' >&2
    exit 1
}
