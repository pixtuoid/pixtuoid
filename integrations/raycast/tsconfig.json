{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*", "raycast-env.d.ts"],
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "ES2022",
    "target": "ES2022",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // `ray build` bundles with esbuild, and bundler resolution is "for use with
    // bundlers".
    // https://www.typescriptlang.org/tsconfig/#moduleResolution
    // https://cdn.jsdelivr.net/npm/@raycast/api@2.12.1/dist/commands/build/index.js
    "moduleResolution": "Bundler",
    // "In TypeScript 6.0, the default `types` value will be `[]`", so Node's
    // globals load only when named.
    // https://devblogs.microsoft.com/typescript/announcing-typescript-6-0/
    "types": ["node"],
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true
  }
}
