{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*", "raycast-env.d.ts"],
  "compilerOptions": {
    "lib": ["ES2023"],
    // `ray build` bundles with esbuild, and TypeScript's guide requires these
    // two for a bundled project.
    // https://www.typescriptlang.org/docs/handbook/modules/guides/choosing-compiler-options.html#im-using-a-bundler
    // https://cdn.jsdelivr.net/npm/@raycast/api@2.12.1/dist/commands/build/index.js
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // "In TypeScript 6.0, the default `types` value will be `[]`", so Node's
    // globals load only when named.
    // https://devblogs.microsoft.com/typescript/announcing-typescript-6-0/
    "types": ["node"],
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true
  }
}
